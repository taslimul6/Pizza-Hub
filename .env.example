# ─────────────────────────────────────────────────────────────
#  PizzaHub client (Next.js) — environment variables
#  Copy this file to ".env" and fill in your own values.
#  Never commit the real ".env" file (it is in .gitignore).
#
#  Deploying to Vercel: add the same variables under
#  Project > Settings > Environment Variables (do not upload a .env file).
#  Use the live addresses instead of localhost:
#    BETTER_AUTH_URL = this app's own URL      (https://your-client.vercel.app)
#    API_URL         = the API's URL, ending in "/"  (https://your-server.vercel.app/)
#  Deploy the API first, then the client, then put each other's URL in
#  (server: AUTH_URL and CLIENT_URL) and redeploy both.
#  Also add the Google redirect URI for the live domain, and allow Vercel to
#  reach MongoDB Atlas (Network Access > 0.0.0.0/0).
# ─────────────────────────────────────────────────────────────

# ── Better Auth ──────────────────────────────────────────────
# Secret used to sign sessions and tokens.
# Generate one with:  npx @better-auth/cli secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Public address of this app. Also the JWT issuer/audience checked by the API.
# Production: https://your-client-domain.com
BETTER_AUTH_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────
# MongoDB connection string (Better Auth stores users and sessions in "pizzaPulse")
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# ── Google sign in ───────────────────────────────────────────
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── PizzaHub API (Express server) ────────────────────────────
# Base address of the API. Production: https://your-server-domain.com/
API_URL=http://localhost:5000/
# Featured items for the home page (the API's /featured route)
FEATURED_API_URL=http://localhost:5000/featured

# ── Images ───────────────────────────────────────────────────
# ImgBB API key for menu item photos and profile photos (https://api.imgbb.com/)
IMGBB_API_KEY=

# ── Admin accounts ───────────────────────────────────────────
# Secret key asked for on /auth/admin to create an admin account.
# Public sign up can never create admins. Use a long random value.
ADMIN_SIGNUP_KEY=

# ── Stripe ───────────────────────────────────────────────────
# Publishable key (pk_test_...). Optional: Checkout is a redirect, so the
# client does not need it today. The secret key lives only on the server.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
