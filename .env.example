# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file.

# Secret used by Better Auth to sign sessions.
# Generate one with: npx @better-auth/cli secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Base URL of the app (use your real domain in production)
BETTER_AUTH_URL=http://localhost:3000

# MongoDB connection string (the app uses the "pizzaPulse" database)
MONGODB_URI=

# Google OAuth (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Featured pizza list API (popular near you section on the home page)
FEATURED_API_URL=http://localhost:5000/featured


# Base URL of the PizzaHub API (items at "/", categories at "/category")
API_URL=http://localhost:5000/

# ImgBB API key for menu item photos (get one at https://api.imgbb.com/)
IMGBB_API_KEY=

# Secret key needed on /auth/admin to create an admin account (keep it private)
ADMIN_SIGNUP_KEY=
